{
  "name": "naturabridgeb-app",
  "version": "1.1.0",
  "description": "NaturaBridgeB — formulation intelligence for supplement businesses (iOS + iPad + Mac + Android + Windows)",
  "private": true,
  "scripts": {
    "sync": "cap sync ios",
    "open:ios": "cap open ios",
    "build:ios": "cap sync ios && cap open ios",
    "build:mac": "cap sync ios && cap open ios",
    "electron": "electron .",
    "build:win": "electron-builder --win --publish never",
    "check": "node build-config/check_www.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0"
  },
  "main": "electron-main.js",
  "build": {
    "appId": "com.naturabridge.business",
    "productName": "NaturaBridgeB",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "www/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "www/icon.ico",
      "shortcutName": "NaturaBridgeB",
      "artifactName": "NaturaBridgeB-Setup-${version}.${ext}"
    },
    "files": [
      "www/**/*",
      "electron-main.js",
      "package.json"
    ],
    "copyright": "Copyright © 2026 Alpha Inception LLC",
    "portable": {
      "artifactName": "NaturaBridgeB-${version}-portable.${ext}"
    }
  },
  "author": {
    "name": "Alpha Inception LLC",
    "email": "andre@alphainception.com"
  }
}
